#!/usr/bin/env bash
# shipcrew git pre-push hook (installed by scripts/install-git-hooks.sh).
# Blocks (1) branch names that break policy and (2) pushes of changes in a configured app without a
# passing gate for that exact commit (run scripts/gate.sh). Overrides, only on the user's word:
#   SHIPCREW_GATE=ci        skip the gate marker (you chose to rely on CI)
#   SHIPCREW_SKIP_GUARD=1   skip everything
[ "${SHIPCREW_SKIP_GUARD:-}" = 1 ] && exit 0
command -v jq >/dev/null 2>&1 || exit 0
. "${SHIPCREW_ROOT:?shipcrew: SHIPCREW_ROOT is not set in the hook wrapper}/lib.sh"
SHIPCREW_CONFIG=$(shipcrew_config) || exit 0
BRANCH_RE=$(shipcrew_branch_re); NOSUFFIX=$(cfg '.policy.forbidNumericSuffix' true)
BASE=$(cfg '.baseBranch' main)
zero='0000000000000000000000000000000000000000'
common=$(git rev-parse --git-common-dir); fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  [[ "$remote_ref" == refs/heads/* ]] || continue
  b="${remote_ref#refs/heads/}"
  shipcrew_is_protected_branch "$b" && continue
  shipcrew_is_exempt_branch "$b" && continue
  bad=0; [[ "$b" =~ $BRANCH_RE ]] || bad=1
  [ "$NOSUFFIX" = true ] && [[ "$b" =~ -[0-9]+$ ]] && bad=1
  if [ $bad = 1 ]; then
    echo "shipcrew: refusing to push '$b'. Branches are <type>/<kebab-name> with no '-<digit>' suffix." >&2
    echo "          Push to the PR's head branch: git push origin HEAD:<headRefName>." >&2
    fail=1; continue
  fi
  [ "${SHIPCREW_GATE:-}" = ci ] && continue
  base=$(git merge-base "origin/$BASE" "$local_sha" 2>/dev/null) || continue
  changed=$(git diff --name-only "$base" "$local_sha")
  while IFS= read -r app; do
    [ -z "$app" ] && continue
    path=$(jq -r '.path' <<<"$app"); name=$(jq -r '.name' <<<"$app")
    grep -q "^$path/" <<<"$changed" || continue
    if [ ! -f "$common/shipcrew-gate/$local_sha.$name" ]; then
      echo "shipcrew: no passing gate for '$name' at ${local_sha:0:10}. Run: scripts/gate.sh $name" >&2
      echo "          Prerequisites down and the user chose CI? Push with SHIPCREW_GATE=ci." >&2
      fail=1
    fi
  done < <(jq -c '.apps // [] | .[]' "$SHIPCREW_CONFIG")
done
exit $fail
